# Server
NODE_ENV=development
PORT=3000
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (placeholders — replace passwords before production/compose use)
POSTGRES_USER=nestly
POSTGRES_PASSWORD=replace_with_strong_postgres_password
POSTGRES_DB=nestly
DATABASE_URL=postgresql://nestly:replace_with_strong_postgres_password@localhost:5433/nestly
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6380

# Logging
LOG_LEVEL=info

# Auth / JWT (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_at_least_32_chars
JWT_TTL=15m
JWT_AUDIENCE=nestly-api

# Rate Limiting
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SEC=60

# Reservations
HOLD_TTL_SECONDS=600

# Payments (in NODE_ENV=production, PAYMENT_PROVIDER must be set explicitly)
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace_with_payment_webhook_secret_at_least_32_characters
PAYMENT_PROVIDER_URL=http://localhost:3001
PAYMENT_MIN_HOLD_SECONDS=60

# Saga & Worker
SAGA_STALE_SECONDS=60
WORKER_ROLES=publisher,schedulers,notification,provider-actions,analytics,search-index
OUTBOX_RETENTION_DAYS=7
NOTIFICATION_RETRY_MINUTES=5

# SQS / ElasticMQ (local free equivalent)
PUBLISHER=sqs
AWS_REGION=us-east-1
SQS_ENDPOINT=http://localhost:9324
AWS_ACCESS_KEY_ID=replace_with_local_s3_sqs_access_key
AWS_SECRET_ACCESS_KEY=replace_with_local_s3_sqs_secret_key
SQS_QUEUE_URL_NOTIFICATIONS=http://localhost:9324/000000000000/notifications
SQS_QUEUE_URL_PROVIDER_ACTIONS=http://localhost:9324/000000000000/provider-actions
SQS_QUEUE_URL_ANALYTICS=http://localhost:9324/000000000000/analytics
SQS_QUEUE_URL_SEARCH_INDEX=http://localhost:9324/000000000000/search-index

# S3 / MinIO (local free equivalent)
MINIO_ROOT_USER=replace_with_minio_root_user
MINIO_ROOT_PASSWORD=replace_with_minio_root_password
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=nestly-media
S3_FORCE_PATH_STYLE=true
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/nestly-media

# OpenSearch (local free single-node equivalent)
OPENSEARCH_ENDPOINT=http://localhost:9200
OPENSEARCH_INDEX_PREFIX=nestly

# Observability (Step 13B)
API_METRICS_PORT=9100
WORKER_METRICS_PORT=9101
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=replace_with_grafana_admin_password
