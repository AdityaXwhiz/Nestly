# Server
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://nestly:nestly_dev@localhost:5433/nestly
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6380

# Logging
LOG_LEVEL=info

# Auth / JWT
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_at_least_32_chars
JWT_TTL=15m
JWT_AUDIENCE=nestly-api

# Rate Limiting
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SEC=60
