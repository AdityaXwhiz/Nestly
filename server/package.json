{
  "name": "nestly-server",
  "version": "0.1.0",
  "description": "Nestly — property & event-services marketplace (server)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1",
    "mock-provider": "node src/infrastructure/payment/mockProvider.js",
    "worker": "node src/workers/index.js",
    "queues:setup": "node src/infrastructure/sqs/setupQueues.js",
    "storage:setup": "node src/infrastructure/s3/setupStorage.js",
    "search:reindex": "node src/infrastructure/opensearch/reindex.js",
    "dlq:inspect": "node src/infrastructure/sqs/dlqTool.js inspect",
    "dlq:redrive": "node src/infrastructure/sqs/dlqTool.js redrive",
    "migrate:up": "node-pg-migrate up --envPath ../.env",
    "migrate:down": "node-pg-migrate down --envPath ../.env",
    "migrate:create": "node-pg-migrate create --envPath ../.env"
  },
  "keywords": [],
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/client-sqs": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "@opensearch-project/opensearch": "^3.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
